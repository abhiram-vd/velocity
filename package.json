{
  "name": "velocity-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"index.html\" \"package.json\" \"tsconfig*.json\" \"vite.config.ts\" \"README.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"index.html\" \"package.json\" \"tsconfig*.json\" \"vite.config.ts\" \"README.md\""
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
